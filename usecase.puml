actor "Admin" as Admin

rectangle "Platform Pembelajaran Seni Rupa" {
    (Registrasi) as UC1
    (Login) as UC2
    (Mengelola Profil) as UC3
    (Mengunggah Karya Seni) as UC4
    (Melihat Galeri Seni) as UC5
    (Memberikan Komentar) as UC6
    (Mengikuti Kursus Seni) as UC7
    (Mengikuti Lomba Seni) as UC8
    (Mendapatkan Umpan Balik dari Mentor) as UC9
    (Mengelola Kursus) as UC10
    (Menilai Karya Seni) as UC11
    (Menampilkan Statistik Pengguna) as UC12
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
